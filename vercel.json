{
  "proxy": {
    "entrypoint": "proxy.js",
    "matcher": ["/esgrima/:path*", "/esgrima.html"]
  },
  "rewrites": [
    {
      "source": "/esgrima",
      "destination": "/esgrima.html"
    },
    {
      "source": "/esgrima/",
      "destination": "/esgrima.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
